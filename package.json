{
  "name": "deepseek-harness-portable-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/prepare-upstream-submodule.cjs",
    "test": "pnpm run packaging:test && pnpm run desktop:test && pnpm run desktop:updater:test",
    "packaging:test": "tsx --test scripts/packaging-cache.test.ts",
    "readme:check": "node scripts/check-readme-i18n.cjs",
    "build": "pnpm --filter @deepseek-ai/dsh-root run build && pnpm --filter @dsh-portable/vision-bridge run build && pnpm --filter dsh-desktop-web-pkg run build",
    "desktop:bootstrap": "git submodule update --init --recursive && pnpm install",
    "desktop:dev": "pnpm --filter dsh-desktop-web-pkg start",
    "desktop:test": "pnpm --filter dsh-desktop-web-pkg test",
    "desktop:updater:test": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/desktop/tests/Run-Tests.ps1",
    "desktop:package:win": "pnpm exec tsx scripts/build-desktop-web-exe.ts --electron",
    "desktop:make:win": "pnpm exec tsx scripts/build-desktop-web-exe.ts --electron",
    "desktop:release:win": "pnpm exec tsx scripts/release-windows.ts",
    "desktop:package:mac": "pnpm exec tsx scripts/build-desktop-web-exe.ts --electron --platform darwin --arch arm64 --dmg",
    "desktop:make:mac": "pnpm run desktop:package:mac",
    "desktop:release:mac": "pnpm exec tsx scripts/release-macos.ts",
    "desktop:package:exe": "pnpm exec tsx scripts/build-desktop-web-exe.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
